# Copia este archivo como .env.production.local en el servidor.
# Estas credenciales solo crean el primer administrador cuando la base está vacía.
DIIP_ADMIN_EMAIL=administracion@tu-empresa.mx
DIIP_ADMIN_PASSWORD=cambia-esta-clave-segura

# Usa el origen público exacto, sin diagonal final.
DIIP_PUBLIC_ORIGIN=https://asistencia.tu-empresa.mx

# Opcional: ubicación persistente para SQLite.
# DIIP_DATA_DIR=/home/ubuntu/diip-data
